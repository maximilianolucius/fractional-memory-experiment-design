\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{aims_math_style}[2026/08/17 AIMS Mathematics submission layout]

\RequirePackage[a4paper,top=1in,bottom=1in,left=0.75in,right=0.75in,headheight=16pt,headsep=12pt,footskip=28pt]{geometry}
\RequirePackage{newtxtext,newtxmath}
\RequirePackage{titlesec}
\RequirePackage{caption}
\RequirePackage{fancyhdr}
\RequirePackage{xcolor}
\RequirePackage{etoolbox}
\RequirePackage{setspace}

% Official AIMS Mathematics Word template uses Times New Roman with a 10.5 pt
% normal text size.  newtx is the closest TeX-native Times family.
\AtBeginDocument{\fontsize{10.5pt}{13pt}\selectfont}
\setlength{\parindent}{1.5em}
\setlength{\parskip}{0pt}
\setlength{\emergencystretch}{2em}
\frenchspacing

\titleformat{\section}
  {\normalfont\bfseries\fontsize{12pt}{14pt}\selectfont}
  {\thesection.}{0.55em}{}
\titlespacing*{\section}{0pt}{15pt plus 2pt minus 2pt}{7pt}
\titleformat{\subsection}
  {\normalfont\bfseries\fontsize{11pt}{13pt}\selectfont}
  {\thesubsection.}{0.5em}{}
\titlespacing*{\subsection}{0pt}{11pt plus 2pt minus 2pt}{5pt}
\titleformat{\subsubsection}
  {\normalfont\bfseries\fontsize{10.5pt}{12.5pt}\selectfont}
  {\thesubsubsection.}{0.5em}{}
\titlespacing*{\subsubsection}{0pt}{9pt}{4pt}

\captionsetup{font=small,labelfont=bf,labelsep=period,justification=justified,singlelinecheck=false}
\setlength{\textfloatsep}{12pt plus 2pt minus 2pt}
\setlength{\floatsep}{10pt plus 2pt minus 2pt}
\setlength{\intextsep}{10pt plus 2pt minus 2pt}

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\fancyfoot[L]{\fontsize{9pt}{10pt}\selectfont AIMS Mathematics}
\fancyfoot[R]{\fontsize{9pt}{10pt}\selectfont \thepage}

\makeatletter
\renewcommand\@biblabel[1]{#1.}
\makeatother

\newcommand{\AIMSJournalHeader}{%
  \vspace*{-0.65cm}%
  \noindent
  \begin{minipage}[t]{0.54\textwidth}
    \includegraphics[width=0.70\linewidth]{aims_mathematics_logo.png}\\[-1pt]
    {\fontsize{10pt}{12pt}\selectfont https://www.aimspress.com/journal/Math}
  \end{minipage}\hfill
  \begin{minipage}[t]{0.40\textwidth}
    \raggedright\fontsize{10pt}{13pt}\selectfont
    AIMS Mathematics, Volume (Issue): Page\\
    DOI:\\
    Received:\\
    Revised:\\
    Accepted:\\
    Published:
  \end{minipage}
  \par\vspace{8pt}
  \hrule height 1.2pt
  \vspace{7pt}
}

\newcommand{\AIMSResearchArticle}{%
  {\bfseries\itshape\fontsize{12pt}{14pt}\selectfont Research article}\par\vspace{7pt}
}

\newcommand{\AIMSTitle}[1]{%
  {\bfseries\fontsize{16pt}{19pt}\selectfont #1\par}\vspace{13pt}
}

\newcommand{\AIMSAuthors}[1]{%
  {\bfseries\fontsize{12pt}{14pt}\selectfont #1\par}\vspace{9pt}
}

\newcommand{\AIMSAffiliation}[1]{%
  {\fontsize{10.5pt}{13pt}\selectfont #1\par}\vspace{10pt}
}

\newcommand{\AIMSCorrespondence}[1]{%
  {\fontsize{10.5pt}{13pt}\selectfont\textbf{* Correspondence:} #1\par}\vspace{10pt}
}

\newenvironment{AIMSAbstract}{%
  \par\noindent\textbf{Abstract:}\ }{\par\vspace{6pt}}

\newcommand{\AIMSKeywords}[1]{%
  \par\noindent\textbf{Keywords:} #1\par
}

\newcommand{\AIMSMSC}[1]{%
  \par\noindent\textbf{Mathematics Subject Classification:} #1\par\vspace{10pt}
  \hrule height 1.2pt\vspace{8pt}
}

\newcommand{\AIMSSupplementHeader}[1]{%
  \vspace*{-0.55cm}%
  \noindent\includegraphics[width=0.34\textwidth]{aims_mathematics_logo.png}\par
  \vspace{5pt}\hrule height 1.2pt\vspace{8pt}
  {\bfseries\fontsize{15pt}{18pt}\selectfont Supplementary Material\par}\vspace{7pt}
  {\bfseries\fontsize{13pt}{16pt}\selectfont #1\par}\vspace{12pt}
}
